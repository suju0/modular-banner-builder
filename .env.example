# ---------------------------------------------------------------------------
# 배경 제거(누끼) 프로바이더 설정 — 필요한 것만 채우면 됩니다.
# 아무것도 설정하지 않으면 "간편 누끼"(흰/단색 배경 전용, 브라우저 로컬 처리)가
# 기본 프로바이더로 동작합니다. 사이드바에서 언제든 다른 방식을 고를 수 있습니다.
# ---------------------------------------------------------------------------

# remove.bg API 키 — 상용 품질의 AI 누끼
# 주의: Vite 의 VITE_ 접두사 값은 클라이언트 번들에 그대로 노출됩니다.
#       사내망 어드민이 아니라면 키를 직접 넣지 말고 아래 프록시 방식을 쓰세요.
VITE_REMOVEBG_API_KEY=

# 자체 호스팅 누끼 서버 (rembg / BiRefNet / remove.bg 프록시 등)
# 요구 스펙: multipart/form-data 로 이미지 1장 수신 → PNG(알파 포함) 응답
VITE_BG_REMOVE_ENDPOINT=
# 위 서버가 기대하는 파일 필드명 (rembg 기본값은 file)
VITE_BG_REMOVE_FIELD=file

# 브라우저 AI 누끼(@imgly/background-removal) 모듈 URL
# 기본값은 jsDelivr CDN 런타임 로드 — AGPL-3.0 라이선스이므로 번들에 포함하지 않습니다.
# 상업적 사용 전 라이선스 검토 필요.
VITE_IMGLY_MODULE_URL=

# ---------------------------------------------------------------------------
# 배경 확장(아웃페인팅) — 선택 사항
# 설정하지 않으면 "엣지 늘리기 / 미러 + 블러"(로컬 합성)로 동작합니다.
# 단색·그라데이션 배경 상품컷에서는 로컬 방식만으로 충분합니다.
# ---------------------------------------------------------------------------

# 사내 생성 모델 서버 (SD/Flux 계열 outpaint).
# 요구 스펙: multipart/form-data 로 image + mask(흰색=생성 영역) 수신 → 이미지 응답
VITE_OUTPAINT_ENDPOINT=
# 위 서버가 기대하는 이미지 필드명 (기본 image)
VITE_OUTPAINT_FIELD=image
